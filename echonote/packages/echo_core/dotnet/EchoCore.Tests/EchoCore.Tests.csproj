<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Run on a newer runtime when .NET 8 is not installed (e.g. only .NET 10). -->
    <RollForward>Major</RollForward>
    <RootNamespace>EchoNote.Audio.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EchoCoreRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..'))</EchoCoreRoot>
    <EchoCoreNativeDir>$(EchoCoreRoot)build/native</EchoCoreNativeDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../EchoCore/EchoCore.csproj" />
  </ItemGroup>

  <!-- Builds the native library with CMake and copies it next to the test
       assembly, where the runtime looks for it. -->
  <Target Name="BuildEchoCoreNative" BeforeTargets="Build">
    <Exec Command="cmake -S &quot;$(EchoCoreRoot).&quot; -B &quot;$(EchoCoreNativeDir)&quot; -DCMAKE_BUILD_TYPE=Release" />
    <Exec Command="cmake --build &quot;$(EchoCoreNativeDir)&quot; --config Release" />
    <ItemGroup>
      <EchoCoreNative Include="$(EchoCoreNativeDir)/**/libecho_core.dylib;$(EchoCoreNativeDir)/**/libecho_core.so;$(EchoCoreNativeDir)/**/echo_core.dll" />
    </ItemGroup>
    <Error Condition="'@(EchoCoreNative)' == ''" Text="CMake built no echo_core library in $(EchoCoreNativeDir)." />
    <Copy SourceFiles="@(EchoCoreNative)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
